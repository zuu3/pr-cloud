[Unit]
Description=홍보부 촬영본 클라우드 (Next standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# /opt/promo/current is a symlink to the active release dir — atomic swap on deploy
WorkingDirectory=/opt/promo/current
EnvironmentFile=/etc/promo/promo.env
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOSTNAME=0.0.0.0
ExecStartPre=/usr/bin/node /opt/promo/current/prisma-cli/node_modules/prisma/build/index.js migrate deploy --schema /opt/promo/current/prisma/schema.prisma
ExecStart=/usr/bin/node /opt/promo/current/server.js
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=6
# 2 GiB VM guard — ffmpeg thumbnail spikes are best-effort and may be killed
MemoryMax=1400M
MemoryHigh=1200M

[Install]
WantedBy=multi-user.target
