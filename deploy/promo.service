[Unit]
Description=홍보부 촬영본 클라우드 (Next standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/promo
EnvironmentFile=/etc/promo/promo.env
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOSTNAME=0.0.0.0
# migrate on every (re)start; entrypoint-style
ExecStartPre=/usr/bin/node /opt/promo/prisma-cli/node_modules/prisma/build/index.js migrate deploy --schema /opt/promo/prisma/schema.prisma
ExecStart=/usr/bin/node /opt/promo/server.js
Restart=on-failure
RestartSec=5
# 2 GiB VM guard — ffmpeg thumbnail spikes are best-effort and may be killed
MemoryMax=1400M
MemoryHigh=1200M

[Install]
WantedBy=multi-user.target
