# Copy to /etc/promo/promo.env on the app VM, fill the <...> blanks, chmod 600.
# Values that are already known for the pr-dept infra are filled in.

# --- database (managed Postgres, RDS pr-dept) ---
DATABASE_URL=postgresql://<db_user>:<db_pass>@10.10.1.7:5432/<db_name>?sslmode=prefer

# --- auth ---
NEXTAUTH_SECRET=<openssl rand -base64 32>
NEXTAUTH_URL=https://<public-app-domain>
GOOGLE_CLIENT_ID=<from Google Cloud console>
GOOGLE_CLIENT_SECRET=<from Google Cloud console>
GOOGLE_HD=bssm.hs.kr

# --- object storage (Ceph RGW) ---
# EXTERNAL = what the browser hits (presigned URLs are signed for this host)
S3_ENDPOINT_EXTERNAL=https://pr-dept-s3.madp.cloud
# INTERNAL = server-side calls (Head/List/Complete/ffmpeg) — go straight to the
# nginx endpoint VM, skip CF/DNS
S3_ENDPOINT_INTERNAL=http://10.10.1.11
S3_REGION=us-east-1
S3_BUCKET=pr-dept-bucket
S3_ACCESS_KEY=<rgw access key>
S3_SECRET_KEY=<rgw secret key>

# --- admin + limits ---
SEED_ADMIN_EMAIL=24.036@bssm.hs.kr
PRESIGN_PUT_TTL=900
PRESIGN_PART_TTL=3600
PRESIGN_GET_TTL=21600
SINGLE_PUT_MAX_BYTES=83886080
# NEXT_PUBLIC_SINGLE_PUT_MAX_BYTES is baked into the image at build time (83886080)
STORAGE_QUOTA_BYTES=5497558138880
